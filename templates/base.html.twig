		.site-footer {
  background-color: #1a1a1a;
  color: #ffffff;
  padding: 40px 20px 20px;
  font-family: Arial, sans-serif;
}

.footer-container {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  max-width: 1200px;
  margin: 0 auto;
  gap: 20px;
}

.footer-col {
  flex: 1;
  min-width: 250px;
}

.footer-col h3 {
  font-size: 1.2rem;
  margin-bottom: 15px;
  color: #f39c12;
}

.footer-col ul {
  list-style: none;
  padding: 0;
}

.footer-col ul li {
  margin-bottom: 8px;
}

.footer-col a {
  color: #dddddd;
  text-decoration: none;
}

.footer-col a:hover {
  color: #f39c12;
}

.footer-bottom {
  text-align: center;
  margin-top: 30px;
  padding-top: 15px;
  border-top: 1px solid #444444;
  font-size: 0.9rem;
  color: #bbbbbb;
}
		
</style>		
		
		
		
		
		
    </head>
